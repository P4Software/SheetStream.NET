<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the library's own modern target, so the tests run against that build too, not only the newest runtime. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\HostileWorkbooks.cs" Link="HostileWorkbooks.cs" />
    <!-- The recorded outcome of every hostile file through every entry point; see HostileWorkbookTests. -->
    <EmbeddedResource Include="HostileWorkbookOutcomes.txt" LogicalName="HostileWorkbookOutcomes.txt" />
    <!-- Workbooks written by Excel, with what Excel says each cell holds. Copied beside the tests because the
         release build maps source paths, so the tests cannot find them from their own file location. -->
    <None Include="..\corpus\excel\*" Link="corpus\excel\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SheetStream\SheetStream.csproj" />
    <!-- Built and copied next to the tests, which start it as a separate process; not linked into them. -->
    <ProjectReference Include="..\SheetStream.MemoryProbe\SheetStream.MemoryProbe.csproj" ReferenceOutputAssembly="false" OutputItemType="None" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\SheetStream.AspNetCore\SheetStream.AspNetCore.csproj" />
  </ItemGroup>

</Project>